{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    // DOM is here for Playwright: a page.evaluate callback is serialised and
    // run inside the browser, so it legitimately references browser globals.
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
